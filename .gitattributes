# Normalize line endings: store LF in the repository for all text files.
* text=auto

# Files that must be LF even when checked out on Windows.
# Shell scripts break with CRLF (#!/usr/bin/env sh), and Go files must stay LF
# so gofmt is consistent across platforms.
*.sh text eol=lf
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.env text eol=lf
*.service text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows PowerShell scripts keep CRLF.
*.ps1 text eol=crlf

# Binary assets must never be line-ending converted.
*.wasm binary
*.docx binary
*.png binary
*.jpg binary
*.pdf binary
