# wasmCat master service environment.
# Copy this file to /etc/wasmcat/master.env and edit values for the host.

MASTER_PORT=7270
CERT_DIR=/etc/wasmcat/certs
AUTO_GENERATE_CERTS=false
DEV_WORKER_ID=worker-vn-01
CLEANUP_INTERVAL=15s
MIN_WORKER_CPU_FREE=0
MIN_WORKER_RAM_FREE_MB=0
EXECUTE_CLIENT_ALLOWLIST=
