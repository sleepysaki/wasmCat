# wasmCat worker service environment.
# Copy this file to /etc/wasmcat/worker.env and edit values for the host.

WORKER_ID=worker-vn-01
WORKER_PORT=7271
MASTER_URL=https://master.example.com:7270
WORKER_ADVERTISE_ADDRESS=worker-vn-01.example.com:7271
CERT_DIR=/etc/wasmcat/certs
HEARTBEAT_INTERVAL=5s
EXECUTION_TIMEOUT=5s
MODULE_FETCH_TIMEOUT=10s
MAX_MODULE_BYTES=10485760
MAX_PAYLOAD_BYTES=1048576
MAX_OUTPUT_BYTES=1048576
MAX_CONCURRENT_EXECS=4
